# Gmail Configuration (required for contact form emails)
GMAIL_USER=deeprajpaul500@gmail.com
GMAIL_APP_PASS=your_gmail_app_password_here

# Server Port (local backend)
PORT=3001

# Python Chatbot Server Port
CHATBOT_PORT=5001

# AI Provider Configuration for Recruiter Chatbot
# Groq (Llama 3.3-70B - Fast & Free tier at https://console.groq.com/)
